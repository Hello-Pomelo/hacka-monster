# Copier ce fichier en .env.local puis compléter les valeurs manquantes.

# Supabase (projet cloud partagé). Clé publique : la sécurité repose sur le RLS.
NEXT_PUBLIC_SUPABASE_URL=https://qyarvgsnrjpqsbphtott.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_r6pgkHEW5nErglnsgAxmZQ_8TaSWt5t

# OpenRouter : une clé par personne (https://openrouter.ai/keys). Serveur uniquement.
OPENROUTER_API_KEY=
# Identifiant du modèle, par exemple un modèle ":free" choisi par l'équipe.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Google OAuth (login + Calendar), client "Client Web 1" du projet Google Cloud. Serveur uniquement.
# Le secret n'est visible qu'à la création : le demander à l'équipe, ne jamais le committer.
GOOGLE_CLIENT_ID=995160855944-i3u8vn85dkcdqb31hgjb0aqi0d8mis62.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# LinkedIn (https://www.linkedin.com/developers/apps). Serveur uniquement.
# URL de redirection à déclarer dans l'app : <origine>/api/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Version de l'API REST au format AAAAMM (facultatif).
LINKEDIN_API_VERSION=
